# URL canônica — usada em metadata, Open Graph, sitemap e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tortasfanor.com

# Google Tag Manager. Sem isto o dataLayer continua recebendo os eventos de
# e-commerce (view_item, add_to_cart, begin_checkout, purchase), só não há
# container publicado para consumi-los.
NEXT_PUBLIC_GTM_ID=

# Mapa de entrega. Sem esta variável usa os tiles públicos do OpenStreetMap.
# Em tráfego alto, troque por um provedor OSM com SLA sem alterar o código.
NEXT_PUBLIC_MAP_TILE_URL=

# Culqi — gateway de pagamento peruano (cartões + Yape).
# Sem CULQI_SECRET_KEY o checkout roda em modo demonstração: aprova o pedido,
# marca `simulated: true` e não cobra nada.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Configure o webhook no CulqiPanel em:
# https://seu-dominio.com/api/webhooks/culqi
CULQI_WEBHOOK_SECRET=

# Transferência manual. A opção só aparece no checkout quando ao menos uma
# conta real está preenchida; nunca use números de exemplo.
PAYMENT_ACCOUNT_HOLDER="Tortas Fanor"
PAYMENT_YAPE_PLIN_NUMBER=
PAYMENT_BCP_ACCOUNT=
PAYMENT_INTERBANK_ACCOUNT=

# Supabase — banco, autenticação do painel e armazenamento de imagens.
# Sem estas variáveis o site roda com o catálogo em arquivo (data/catalog.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA no frontend: ignora RLS. Só em rotas de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Resend). Sem RESEND_API_KEY o envio é simulado:
# registra em email_log como `simulado` e não dispara nada.
RESEND_API_KEY=
# Remetente. Exige domínio verificado no provedor.
EMAIL_FROM="Tortas Fanor <administracion@tortasfanor.com>"
# Quem recebe a ordem de produção. Sem isto, cai no e-mail da marca.
EMAIL_OPS=

# Protege a rotina que apaga fotos de clientes após 90 dias
# (GET /api/cron/limpiar-fotos). Agendar uma vez por dia.
CRON_SECRET=

# Monitoramento genérico. Aceita um endpoint de Sentry/Better Stack/Slack ou
# outro coletor HTTP. Sem URL, erros continuam nos logs do provedor de hosting.
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=

# --- SMTP (alternativa ao Resend) -------------------------------------------
# Usa a caixa que a loja já tem, sem cadastrar serviço novo. Tem prioridade
# sobre RESEND_API_KEY quando SMTP_HOST está preenchido.
# Porta 465 = TLS direto. Porta 587 = STARTTLS. Errar isso trava a conexão.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Mapa do checkout no Google Maps. Sem esta chave o site usa OpenStreetMap e
# funciona igual — o mapa serve só para marcar o ponto de entrega, nunca para
# calcular o frete. Criar em console.cloud.google.com: ative a "Maps
# JavaScript API", restrinja a chave por domínio e limite a cota diária a ~300
# carregamentos para não sair do nível gratuito.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Busca de endereço no checkout. Vazio = usa os serviços públicos gratuitos
# (Photon para busca, Nominatim para reversão), que não pedem chave nem
# cartão. Preencher só se você subir uma instância própria — vale a pena
# quando o volume crescer, porque as instâncias públicas são mantidas por
# doação e pedem uso moderado.
GEOCODER_SEARCH_URL=
GEOCODER_SEARCH_FALLBACK_URL=
GEOCODER_REVERSE_URL=
# Identifica a aplicação, como a política do Nominatim exige.
GEOCODER_USER_AGENT=
