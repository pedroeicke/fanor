# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o modelo, que é documentação: lista toda variável que o site lê,
# sem nenhum valor secreto. Sem ele, quem clona não sabe o que precisa
# configurar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.data/
public/uploads/

# Material bruto do cliente: conversa de WhatsApp com o Joseka, áudios
# originais, gravação de tela. Serviu para levantar o escopo e não faz parte
# do site. Fica de fora porque este repositório é público — o dossiê e o
# checklist derivados dele, sim, estão versionados em docs/.
materiais-cliente/
references/cliente/
