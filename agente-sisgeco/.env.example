# Leitor do Sisgeco — configuração. Copiar para .env no PC da loja.

# SQL Server do Sisgeco. Usuário SÓ DE LEITURA (db_datareader no banco Fanor).
SISGECO_SQL_SERVER=localhost
SISGECO_SQL_PORT=1433
SISGECO_SQL_DATABASE=Fanor
SISGECO_SQL_USER=agente_lectura
SISGECO_SQL_PASSWORD=

# Para onde mandar. O segredo é o mesmo SYNC_SHARED_SECRET do site.
SYNC_URL=https://fanor.vercel.app/api/sync/sisgeco
SYNC_SHARED_SECRET=

# Ritmo. 5 s é imperceptível para o banco e mantém a vitrine em dia.
POLL_MS=5000
BATCH=200
CATALOG_EVERY_MS=600000
STATE_FILE=./state.json
